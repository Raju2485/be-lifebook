<!doctype html>
<html lang="en-US">

<head>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    <title>MI-Email</title>
    <meta name="description" content="Reset Password Email Template.">
    <link href="https://fonts.googleapis.com/css?family=Lato:400,700&display=swap" rel="stylesheet" type="text/css">
    
    
</head>

<body marginheight="0" topmargin="0" marginwidth="0" style="margin: 0px; background-color: rgb(245, 247, 249);"
    leftmargin="0">
    <!--100% body table-->
    <table cellspacing="0" border="0" cellpadding="0" width="100%" style="font-family:'Lato',sans-serif;">
        <tr>
            <td>
                <table style="max-width:670px;  margin:0 auto;" width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td style="height:60px;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td>
                            <table width="95%" border="0" cellpadding="0" cellspacing="0"
                                style="max-width:670px;background:#fff; border-top: 10px solid #0fa479; border-radius:5px;-webkit-box-shadow:0 6px 18px 0 rgba(0,0,0,.06);-moz-box-shadow:0 6px 18px 0 rgba(0,0,0,.06);box-shadow:0 6px 18px 0 rgba(0,0,0,.06); overflow: hidden;padding: 0 35px;">
                                <tr>
                                    <td style="height:20px;">&nbsp;</td>
                                </tr>
                                <tr style="display: flex;align-items: center;justify-content: flex-start;">
                                    <!-- {{!-- <td style="padding:0 5px;float: left;">
                                        <a href="" title="logo" target="_blank">
                                            <img width="50"
                                                src="https://tataproject.blob.core.windows.net/documents/dcceb01c-b9a4-4642-8cce-572d6a42ae39-NeevLogo1.png"
                                                title="logo" alt="logo">
                                        </a>
                                    </td> --}} -->
                                    <td style="padding:0 5px;float: right;">
                                        <a href="" title="logo" target="_blank">
                                            <img width="120"
                                                src='{{logo}}'
                                                title="logo" alt="logo">
                                        </a>
                                    </td>
                                </tr>
                                <!-- <tr>
                                    <td style="height:40px;">&nbsp;</td>
                                </tr> -->


                                <tr>
                                    <td style="padding: 0px 5px;">
                                        <p style="height:1px; background-color: #eee;"></p>
                                    </td>
                                </tr>
                                <tr>
                                    <td
                                        style="padding:30px 35px;text-align:center;background-color: #38B17B;border-radius: 5px;">
                                        
                                        <h5
                                            style="font-size: 24px;text-align: center;color: #F0F0F0;margin: 0 !important;font-weight: 600;">
                                            Reset Password</h5>
                                    </td>

                                </tr>
                                <tr>
                                    <td style="height:30px;">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="padding:0px 0px;">
                                        <p
                                            style="color:#667085;text-align: left; margin: 0px 0px 10px;font-size:14px;font-family:'Lato',sans-serif;">
                                            Dear {{recipient_first_name}},
                                        </p>
                                        <p
                                            style="color:#667085; font-size:14px;line-height:28px;text-align: left; margin:0;">
                                            Kindly click below button to reset password
                                        </p>
                                        
                                    </td>
                                </tr>
                                <tr>
                                    <td style="height:10px;">&nbsp;</td>

                                </tr>
                                <tr>
                                    <td style="padding:0 35px;text-align: center;">
                                        <a href='{{hyperlink}}'
                                            style="background:#38B17B; text-decoration:none !important; font-weight:500; margin-top:15px; color:#fff; font-size:14px;padding:10px 24px;display:inline-block;border-radius:5px;text-align: center;">Reset Password</a>
                                    </td>
                                    <td style="padding:0 35px;text-align: left;">
                                        <p> Or copy & paste this link in browser: {{hyperlink}}</p>
                                    </td>

                                   
                                </tr>
                                <tr>
                                    <td><p
                                        style="color:#667085;text-align: left; font-weight: 400; margin: 0px 0px 10px;font-size:14px;font-family:'Segoe',sans-serif;">
                                    
                                        MI Team 
                                    </p>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="height:20px;">&nbsp;</td>
                                </tr>

                            </table>
                        </td>
                    <tr>
                        <td style="height:20px;">&nbsp;</td>
                    </tr>

                </table>
                <!--/100% body table-->
</body>

</html>